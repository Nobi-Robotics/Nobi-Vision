# Server-only. Never prefix with NEXT_PUBLIC_.
# Create a key at https://console.x.ai/
XAI_API_KEY=

# Vision model for frame analysis. Documented default: grok-4.7
# (text + image input, text output). Override only with another vision-capable id.
XAI_VISION_MODEL=grok-4.7

# grok-4.7 reasoning cannot be disabled. "low" keeps the observation loop responsive.
# Allowed: low | medium | high | xhigh. API default if unset is high.
XAI_REASONING_EFFORT=low

# Grok Voice model for spoken playback. grok-voice-latest currently aliases grok-voice-3.0.
# Versioned alternative: grok-voice-3.0. grok-voice-2.0 is deprecated.
XAI_VOICE_MODEL=grok-voice-latest
